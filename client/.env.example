# Leave empty for local dev. Vite proxies /api to http://127.0.0.1:5000.
# On Vercel, set this to the Railway origin with no trailing slash, then redeploy.
# Verified production API: https://janavignanam-production.up.railway.app
VITE_API_BASE_URL=

# Packaged Android builds set this to true so the WebView uses hash routing
# and does not register the website service worker. Leave it unset on Vercel.
# VITE_CAPACITOR=
